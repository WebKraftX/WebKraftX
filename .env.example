# ========================================================
# WebKraftX Contact Form Serverless Configuration
# Configure ONE of the options below to deliver project
# enquiries directly to: contact.webkraftx@gmail.com
# ========================================================

# OPTION 1: Resend (Recommended, easiest to set up)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_your_api_key_here
CONTACT_NOTIFICATION_EMAIL=contact.webkraftx@gmail.com

# OPTION 2: SMTP / Gmail App Password
# If using Gmail SMTP:
# 1. Enable 2-Step Verification on contact.webkraftx@gmail.com
# 2. Generate an App Password under Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact.webkraftx@gmail.com
SMTP_PASS=your_16_character_app_password_here
